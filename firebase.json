{
  "hosting": {
    "public": "dist",
    "rewrites": [
      {
        "source": "/plants/**",
        "function": {
          "functionId": "plantOg",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "projectId": "garden-steward"
  }
}
